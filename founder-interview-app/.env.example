# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.
#
# Both are server-only - the app never talks to Supabase from the browser,
# only through its own API routes (see app/api/interview/*) - so neither
# needs a NEXT_PUBLIC_ prefix.
#
# If these are left unset, the app falls back to an in-memory repository
# (see lib/interview-repository.ts) so it stays runnable without Supabase.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
